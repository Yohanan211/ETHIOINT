@{
    ViewData["Title"] = "EthioINT";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>EthioINT</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', sans-serif;
        }

        body {
            background: linear-gradient(to bottom,#f8fbff,#eef5ff);
            color: #0f172a;
        }

        .navbar {
            width: 100%;
            height: 85px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 90px;
            background: rgba(255,255,255,0.92);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid #e2e8f0;
            position: fixed;
            top: 0;
            z-index: 1000;
        }

        .logo {
            font-size: 28px;
            font-weight: 700;
            color: #2563eb;
            letter-spacing: 1px;
        }

        .nav-center {
            display: flex;
            gap: 45px;
            align-items: center;
        }

            .nav-center a {
                text-decoration: none;
                color: #334155;
                font-size: 15px;
                transition: 0.3s;
            }

                .nav-center a:hover {
                    color: #2563eb;
                }

        .auth-btn {
            padding: 11px 24px;
            background: #2563eb;
            color: white;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            font-size: 14px;
            transition: 0.3s;
            box-shadow: 0 5px 15px rgba(37,99,235,0.15);
        }

            .auth-btn:hover {
                background: #1d4ed8;
            }

        .hero {
            min-height: 100vh;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 130px 90px 70px;
            gap: 60px;
        }

        .hero-text {
            max-width: 580px;
        }

        .hero-tag {
            display: inline-block;
            padding: 10px 18px;
            background: #dbeafe;
            color: #2563eb;
            border-radius: 30px;
            margin-bottom: 30px;
            font-size: 14px;
            font-weight: 500;
        }

        .hero-text h1 {
            font-size: 68px;
            line-height: 1.05;
            margin-bottom: 28px;
            color: #0f172a;
            font-weight: 700;
            letter-spacing: -2px;
        }

        .highlight {
            color: #2563eb;
        }

        .hero-text p {
            font-size: 18px;
            line-height: 1.8;
            color: #64748b;
            margin-bottom: 38px;
        }

        .hero-buttons {
            display: flex;
            gap: 18px;
        }

        .primary-btn {
            padding: 15px 32px;
            border: none;
            border-radius: 12px;
            background: #2563eb;
            color: white;
            font-size: 15px;
            cursor: pointer;
            box-shadow: 0 8px 20px rgba(37,99,235,0.15);
        }

        .secondary-btn {
            padding: 15px 32px;
            border-radius: 12px;
            border: 1px solid #dbe3f0;
            background: white;
            color: #2563eb;
            cursor: pointer;
            font-size: 15px;
        }

        .hero-image {
            width: 540px;
            height: 520px;
            border-radius: 30px;
            overflow: hidden;
            background: white;
            box-shadow: 0 20px 50px rgba(37,99,235,0.10);
            border: 1px solid #e2e8f0;
        }

            .hero-image img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .stats {
            display: flex;
            justify-content: center;
            gap: 120px;
            padding-bottom: 90px;
        }

        .stat-box {
            text-align: center;
        }

            .stat-box h2 {
                color: #2563eb;
                font-size: 42px;
                margin-bottom: 10px;
            }

            .stat-box p {
                color: #64748b;
                font-size: 15px;
            }

        .services {
            padding: 100px 90px;
            background: white;
        }

        .section-title {
            text-align: center;
            font-size: 42px;
            margin-bottom: 20px;
            color: #0f172a;
        }

        .section-subtitle {
            text-align: center;
            color: #64748b;
            max-width: 700px;
            margin: auto;
            line-height: 1.8;
            margin-bottom: 70px;
        }

        .service-grid {
            display: grid;
            grid-template-columns: repeat(3,1fr);
            gap: 30px;
        }

        .service-card {
            background: #f8fbff;
            border: 1px solid #e2e8f0;
            padding: 40px;
            border-radius: 24px;
            transition: 0.3s;
        }

            .service-card:hover {
                transform: translateY(-6px);
                box-shadow: 0 15px 35px rgba(37,99,235,0.08);
            }

        .service-icon {
            width: 65px;
            height: 65px;
            background: #dbeafe;
            border-radius: 18px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 28px;
            margin-bottom: 25px;
        }

        .service-card h3 {
            margin-bottom: 16px;
            color: #0f172a;
            font-size: 22px;
        }

        .service-card p {
            color: #64748b;
            line-height: 1.8;
        }

    </style>

</head>

<body>

    <nav class="navbar">

        <div class="logo">
            EthioINT
        </div>

        <div class="nav-center">
            <a href="#">Home</a>
            <a href="#">Services</a>
            <a href="#">Coverage</a>
            <a href="#">About</a>
            <a href="#">Support</a>
        </div>

        <a href="/Home/Auth">
            <button class="auth-btn">
                Login / Register
            </button>
        </a>

    </nav>

    <section class="hero">

        <div class="hero-text">

            <div class="hero-tag">
                Fast • Reliable • Digital
            </div>

            <h1>
                Connecting You To A
                <span class="highlight">Better Future</span>
            </h1>

            <p>
                EthioINT delivers modern internet solutions with smart service
                management, secure payments, technical support,
                and digital customer experience all in one platform.
            </p>

            <div class="hero-buttons">

                <button class="primary-btn">
                    Get Started
                </button>
               
               

                <button class="secondary-btn">
                    Explore Packages
                </button>

            </div>

        </div>

        <div class="hero-image">

            <img src="https://images.unsplash.com/photo-1516321318423-f06f85e504b3?q=80&w=1200&auto=format&fit=crop">

        </div>

    </section>

    <div class="stats">

        <div class="stat-box">
            <h2>99.9%</h2>
            <p>Network Uptime</p>
        </div>

        <div class="stat-box">
            <h2>24/7</h2>
            <p>Customer Support</p>
        </div>

        <div class="stat-box">
            <h2>300+</h2>
            <p>Mbps Capacity</p>
        </div>

    </div>

    <section class="services">

        <h2 class="section-title">
            Smart Solutions For Every Need
        </h2>

        <p class="section-subtitle">
            From high-speed internet packages to digital customer service,
            EthioINT simplifies connectivity through efficient and modern solutions.
        </p>

        <div class="service-grid">

            <div class="service-card">

                <div class="service-icon">
                    🌐
                </div>

                <h3>High-Speed Internet</h3>

                <p>
                    Stable and scalable connectivity solutions optimized
                    for homes, offices, and organizations.
                </p>

            </div>

            <div class="service-card">

                <div class="service-icon">
                    💳
                </div>

                <h3>Digital Payments</h3>

                <p>
                    Securely manage subscriptions and submit payments
                    through an integrated digital platform.
                </p>

            </div>

            <div class="service-card">

                <div class="service-icon">
                    🛠
                </div>

                <h3>Technical Support</h3>

                <p>
                    Request technicians, monitor issues, and receive
                    customer assistance efficiently online.
                </p>

            </div>

        </div>

    </section>

</body>
</html>