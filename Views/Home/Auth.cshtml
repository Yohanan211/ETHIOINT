@{
    ViewData["Title"] = "Authentication";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EthioINT Authentication</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }

        body {
            background: linear-gradient(to bottom right,#dbeafe,#eff6ff);
            min-height: 100vh;
        }

        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100vh;
            background: rgba(15,23,42,0.55);
            backdrop-filter: blur(8px);
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 30px 20px;
        }

        .auth-container {
            width: 1100px;
            max-height: 90vh;
            background: white;
            border-radius: 30px;
            overflow: hidden;
            display: flex;
            box-shadow: 0 25px 60px rgba(0,0,0,0.15);
        }

        /* ========================= */
        /* LEFT SIDE */
        /* ========================= */

        .auth-left {
            width: 42%;
            background: linear-gradient(to bottom right,#2563eb,#1d4ed8);
            color: white;
            padding: 60px 45px;
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
            overflow-y: auto;
        }

            .auth-left h1 {
                font-size: 44px;
                line-height: 1.1;
                margin-bottom: 18px;
            }

            .auth-left p {
                line-height: 1.8;
                color: #dbeafe;
                margin-bottom: 28px;
            }

        .auth-features {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .feature-item {
            background: rgba(255,255,255,0.10);
            padding: 16px 18px;
            border-radius: 14px;
            backdrop-filter: blur(10px);
        }

        /* ========================= */
        /* RIGHT SIDE */
        /* ========================= */

        .auth-right {
            width: 58%;
            padding: 45px 55px;
            overflow-y: auto;
            padding-bottom: 70px;
        }

        .tab-buttons {
            display: flex;
            gap: 15px;
            margin-bottom: 25px;
        }

        .tab-btn {
            padding: 12px 26px;
            border: none;
            border-radius: 10px;
            background: #eff6ff;
            color: #2563eb;
            cursor: pointer;
            font-size: 15px;
            font-weight: 600;
            transition: 0.3s;
        }

            .tab-btn.active {
                background: #2563eb;
                color: white;
            }

        .auth-right h2 {
            margin-bottom: 22px;
            color: #0f172a;
            font-size: 30px;
        }

        /* ========================= */
        /* MESSAGE BOX */
        /* ========================= */

        .auth-message {
            margin-bottom: 20px;
            padding: 16px 18px;
            border-radius: 14px;
            font-size: 14px;
            line-height: 1.6;
            animation: fadeIn 0.3s ease;
            display: none;
        }

            .auth-message.error {
                background: #fef2f2;
                border: 1px solid #fecaca;
                color: #b91c1c;
            }

            .auth-message.success {
                background: #effdf5;
                border: 1px solid #bbf7d0;
                color: #047857;
            }

        /* ========================= */
        /* INPUTS */
        /* ========================= */

        .input-group {
            display: flex;
            flex-direction: column;
            margin-bottom: 18px;
            position: relative;
        }

            .input-group label {
                margin-bottom: 10px;
                color: #334155;
                font-size: 14px;
                font-weight: 600;
            }

            .input-group input,
            .input-group select {
                height: 55px;
                border: 1px solid #dbe3f0;
                border-radius: 14px;
                padding: 0 18px;
                font-size: 15px;
                outline: none;
                transition: 0.3s;
                background: #f8fbff;
            }

                .input-group input:focus,
                .input-group select:focus {
                    border-color: #2563eb;
                    background: white;
                }

                .input-group input::placeholder {
                    color: #94a3b8;
                }

        /* ========================= */
        /* PASSWORD */
        /* ========================= */

        .password-group {
            position: relative;
        }

        .toggle-password {
            position: absolute;
            right: 18px;
            top: 48px;
            cursor: pointer;
            color: #64748b;
        }

        /* ========================= */
        /* REMEMBER */
        /* ========================= */

        .remember-section {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 28px;
            color: #475569;
            font-size: 14px;
        }

            .remember-section a {
                text-decoration: none;
                color: #2563eb;
            }

        /* ========================= */
        /* BUTTON */
        /* ========================= */

        .submit-btn {
            width: 100%;
            height: 58px;
            border: none;
            border-radius: 14px;
            background: #2563eb;
            color: white;
            font-size: 16px;
            cursor: pointer;
            margin-top: 20px;
            transition: 0.3s;
            box-shadow: 0 10px 25px rgba(37,99,235,0.15);
        }

            .submit-btn:hover {
                background: #1d4ed8;
            }

        /* ========================= */
        /* GRID */
        /* ========================= */

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        .full-width {
            grid-column: span 2;
        }

    </style>
</head>

<body>

    <div class="modal-overlay">

        <div class="auth-container">

            <!-- LEFT -->

            <div class="auth-left">

                <h1>Welcome to EthioINT</h1>

                <p>
                    Securely manage your internet services,
                    subscriptions, technical support requests,
                    and digital payments through one
                    professional platform.
                </p>

                <div class="auth-features">

                    <div class="feature-item">
                        ✔ Secure Digital Access
                    </div>

                    <div class="feature-item">
                        ✔ Online Payment Management
                    </div>

                    <div class="feature-item">
                        ✔ Technician Request System
                    </div>

                    <div class="feature-item">
                        ✔ Subscription Monitoring
                    </div>

                </div>

            </div>

            <!-- RIGHT -->

            <div class="auth-right">

                <div class="tab-buttons">

                    <button class="tab-btn active"
                            onclick="showLogin()">
                        Login
                    </button>

                    <button class="tab-btn"
                            onclick="showRegister()">
                        Register
                    </button>

                </div>

                <!-- MESSAGE -->

                <div id="authMessage"
                     class="auth-message">
                </div>

                <!-- LOGIN -->

                <div id="loginForm">

                    <h2>Account Login</h2>

                    <div class="input-group">

                        <label>Email or Phone Number</label>

                        <input type="text"
                               placeholder="Enter your email"
                               id="loginEmail">

                    </div>

                    <div class="input-group password-group">

                        <label>Password</label>

                        <input type="password"
                               placeholder="Enter your password"
                               id="loginPassword">

                        <span class="toggle-password"
                              onclick="togglePassword('loginPassword', this)">
                            👁
                        </span>

                    </div>

                    <div class="remember-section">

                        <div>
                            <input type="checkbox">
                            Remember Me
                        </div>

                        <a href="#">
                            Forgot Password?
                        </a>

                    </div>

                    <button class="submit-btn"
                            onclick="loginUser()">
                        Login
                    </button>

                </div>

                <!-- REGISTER -->

                <div id="registerForm"
                     style="display:none;">

                    <h2>Create Account</h2>

                    <div class="form-grid">

                        <div class="input-group">

                            <label>Full Name</label>

                            <input type="text"
                                   placeholder="Enter your full name"
                                   id="registerName">

                        </div>

                        <div class="input-group">

                            <label>Email Address</label>

                            <input type="email"
                                   placeholder="Enter your email"
                                   id="registerEmail">

                        </div>

                        <div class="input-group">

                            <label>Phone Number</label>

                            <input type="text"
                                   placeholder="Enter your phone number">

                        </div>

                        <div class="input-group">

                            <label>Alternative Phone</label>

                            <input type="text"
                                   placeholder="Optional">

                        </div>

                        <div class="input-group">

                            <label>Account Type</label>

                            <select>
                                <option>Home User</option>
                                <option>Office / Business</option>
                                <option>Internet Cafe</option>
                                <option>Organization</option>
                            </select>

                        </div>

                        <div class="input-group">

                            <label>City / Region</label>

                            <input type="text"
                                   placeholder="Enter your location">

                        </div>

                        <div class="input-group full-width">

                            <label>Address / Landmark</label>

                            <input type="text"
                                   placeholder="Enter detailed address">

                        </div>

                        <div class="input-group password-group">

                            <label>Password</label>

                            <input type="password"
                                   placeholder="Create password"
                                   id="registerPassword">

                            <span class="toggle-password"
                                  onclick="togglePassword('registerPassword', this)">
                                👁
                            </span>

                        </div>

                        <div class="input-group password-group">

                            <label>Confirm Password</label>

                            <input type="password"
                                   placeholder="Confirm password"
                                   id="confirmPassword">

                            <span class="toggle-password"
                                  onclick="togglePassword('confirmPassword', this)">
                                👁
                            </span>

                        </div>

                    </div>

                    <button class="submit-btn"
                            onclick="registerUser()">
                        Create Account
                    </button>

                </div>

            </div>

        </div>

    </div>

    <script>

        let users = [];

        function showRegister(){

            document.getElementById("loginForm")
            .style.display = "none";

            document.getElementById("registerForm")
            .style.display = "block";

            hideMessage();

            document.querySelectorAll(".tab-btn")[0]
            .classList.remove("active");

            document.querySelectorAll(".tab-btn")[1]
            .classList.add("active");
        }

        function showLogin(){

            document.getElementById("loginForm")
            .style.display = "block";

            document.getElementById("registerForm")
            .style.display = "none";

            hideMessage();

            document.querySelectorAll(".tab-btn")[0]
            .classList.add("active");

            document.querySelectorAll(".tab-btn")[1]
            .classList.remove("active");
        }

        function togglePassword(id, element){

            const input =
            document.getElementById(id);

            if(input.type === "password"){

                input.type = "text";

                element.innerHTML = "🚫";
            }

            else{

                input.type = "password";

                element.innerHTML = "👁";
            }
        }

        function showMessage(message, type){

            const box =
            document.getElementById("authMessage");

            box.style.display = "block";

            box.innerHTML = message;

            box.className =
            "auth-message " + type;
        }

        function hideMessage(){

            document.getElementById("authMessage")
            .style.display = "none";
        }

        function registerUser(){

            const fullName =
            document.getElementById("registerName").value;

            const email =
            document.getElementById("registerEmail").value;

            const password =
            document.getElementById("registerPassword").value;

            const confirmPassword =
            document.getElementById("confirmPassword").value;

            if(password !== confirmPassword){

                showMessage(
                    "Passwords do not match. Please confirm your password correctly.",
                    "error"
                );

                return;
            }

            const existingUser =
            users.find(user => user.email === email);

            if(existingUser){

                showMessage(
                    "An account with this email already exists. Please login instead.",
                    "error"
                );

                return;
            }

            users.push({
                name: fullName,
                email: email,
                password: password
            });

            showMessage(
                "Account successfully created. Redirecting...",
                "success"
            );

            setTimeout(() => {

                window.location.href =
                "/Home/Welcome";

            }, 1200);
        }

        function loginUser(){

            const email =
            document.getElementById("loginEmail").value;

            const password =
            document.getElementById("loginPassword").value;

            const foundUser =
            users.find(user => user.email === email);

            if(!foundUser){

                showMessage(
                    "Account not found. Please register first before logging in.",
                    "error"
                );

                return;
            }

            if(foundUser.password !== password){

                showMessage(
                    "Incorrect password. Please enter the correct password.",
                    "error"
                );

                return;
            }

            showMessage(
                "Login successful. Redirecting...",
                "success"
            );

            setTimeout(() => {

                window.location.href =
                "/Home/Welcome";

            }, 1000);
        }

    </script>

</body>
</html>